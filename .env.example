# ==================================================
# Example Environment
# 環境変数サンプル
# ==================================================

# --- Spring Boot ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- CORS ---
FRONTEND_URL=http://localhost:3000

# --- JWT ---
JWT_SECRET_KEY=test
JWT_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

# --- Database ---
DB_HOST=db
DB_PORT=5432
DB_NAME=your-db-name
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password

# --- Debug ---
DEBUG=false
